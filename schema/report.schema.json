{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aihostcheck.bond/schemas/report-1.0.0.json",
  "title": "AIHostCheck Report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tool_version", "platform", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string"},
    "platform": {"type": "string"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source", "detail"],
      "properties": {"source": {"type": "string"}, "detail": {"type": "string"}}
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["detected", "not_detected", "unknown", "unsupported", "error", "permission_denied"]},
        "value": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "details": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
